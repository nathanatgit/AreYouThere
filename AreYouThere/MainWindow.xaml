<Window x:Class="AreYouThere.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" Title="在吗 AreYouThere">
  <!-- 启动时把键盘焦点放在滚动区域，避免焦点落在摄像头开关上被误按空格开启 -->
  <ScrollViewer x:Name="RootScroll" IsTabStop="True">
    <!-- 宽窗口：设置在左、小预览在右；窄窗口：单列，预览在下方。切换逻辑见 LayoutRoot_SizeChanged -->
    <Grid x:Name="LayoutRoot" Padding="32" MaxWidth="1100" ColumnSpacing="32" RowSpacing="18"
          SizeChanged="LayoutRoot_SizeChanged">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Grid.ColumnSpan="2" Spacing="12">
        <StackPanel Orientation="Horizontal" Spacing="14">
          <Image Source="ms-appx:///Assets/logo.png" Width="48" Height="48" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="在吗" FontSize="30" FontWeight="SemiBold" />
            <TextBlock Text="AreYouThere" Opacity="0.6" />
          </StackPanel>
        </StackPanel>
        <TextBlock Opacity="0.75" TextWrapping="Wrap"
          Text="微软官方的「存在感知」(Presence Sensing) 只在部分新款设备上提供。「在吗」是它的轻量替代方案：用普通摄像头判断你是否在电脑前，在的时候暂时阻止 Windows 自动息屏。" />
        <InfoBar IsOpen="True" Severity="Success" IsClosable="False" Title="完全离线，只在本机处理"
          Message="「在吗」没有任何联网功能：不上传、不收集、不保存任何画面或数据。摄像头画面只在本机内存中分析，分析完立即丢弃。" />
      </StackPanel>

      <StackPanel x:Name="SettingsPanel" Grid.Row="1" Spacing="18">
        <InfoBar IsOpen="True" Severity="Warning" IsClosable="False"
          Message="隐私提醒：启用后摄像头指示灯会亮起（显示预览时常亮，后台运行时每次检测短暂亮起）。请勿在隐私敏感场所使用，以免产生误会或纠纷。" />
        <InfoBar x:Name="AwakeWarning" IsOpen="False" Visibility="Collapsed" Severity="Warning" IsClosable="False" Title="可能存在冲突" />
        <InfoBar x:Name="CameraProblem" IsOpen="False" Visibility="Collapsed" Severity="Error" IsClosable="False">
          <InfoBar.ActionButton>
            <Button x:Name="CameraPrivacyButton" Content="打开摄像头隐私设置" Click="CameraPrivacyButton_Click" />
          </InfoBar.ActionButton>
        </InfoBar>
        <StackPanel Spacing="8">
          <TextBlock Text="摄像头" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ComboBox x:Name="CameraBox" MinWidth="300" MaxWidth="420" PlaceholderText="正在查找摄像头…"
                      SelectionChanged="CameraBox_SelectionChanged" />
            <Button Content="刷新" Click="RefreshCameras_Click" />
          </StackPanel>
          <TextBlock Text="有些电脑上摄像头名称显示不准确。不确定是哪一个时，可以开启检测并查看右侧预览来确认。"
                     Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
        <ToggleSwitch x:Name="EnabledSwitch" Header="启用在场检测" Toggled="EnabledSwitch_Toggled" />
        <ToggleSwitch x:Name="PreviewSwitch" Header="显示摄像头预览" IsOn="True" Toggled="PreviewSwitch_Toggled" />
        <StackPanel Spacing="8">
          <TextBlock Text="检测间隔" />
          <ComboBox x:Name="IntervalBox" SelectedIndex="2" SelectionChanged="IntervalBox_SelectionChanged" Width="220">
            <ComboBoxItem Content="15 秒" Tag="15" />
            <ComboBoxItem Content="30 秒" Tag="30" />
            <ComboBoxItem Content="1 分钟（默认）" Tag="60" />
            <ComboBoxItem Content="2 分钟" Tag="120" />
            <ComboBoxItem Content="5 分钟" Tag="300" />
          </ComboBox>
        </StackPanel>
        <StackPanel Spacing="8">
          <RadioButtons x:Name="AwayModeButtons" Header="离开电脑后" SelectedIndex="0"
                        SelectionChanged="AwayModeButtons_SelectionChanged">
            <x:String>跟随系统电源策略</x:String>
            <x:String>由「在吗」接管：检测到离开后锁定电脑</x:String>
          </RadioButtons>
          <ComboBox x:Name="LockDelayBox" Header="锁定时机" Width="260" SelectedIndex="2" Visibility="Collapsed"
                    SelectionChanged="LockDelayBox_SelectionChanged">
            <ComboBoxItem Content="立即锁定" Tag="0" />
            <ComboBoxItem Content="延迟 15 秒后锁定" Tag="15" />
            <ComboBoxItem Content="延迟 30 秒后锁定" Tag="30" />
            <ComboBoxItem Content="延迟 1 分钟后锁定" Tag="60" />
            <ComboBoxItem Content="延迟 2 分钟后锁定" Tag="120" />
            <ComboBoxItem Content="延迟一个检测间隔后锁定" Tag="-1" />
          </ComboBox>
          <TextBlock x:Name="PolicyText" Opacity="0.75" TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock x:Name="StatusText" Text="状态：未启用" Opacity="0.75" TextWrapping="Wrap" />
        <TextBlock Text="关闭此窗口后程序会继续在右下角托盘运行。单击托盘图标打开窗口，右键可启用/关闭或退出。" TextWrapping="Wrap" Opacity="0.65" />
        <TextBlock x:Name="PowerSummaryText" TextWrapping="Wrap" Opacity="0.75" />
      </StackPanel>

      <Border x:Name="PreviewCard" Grid.Row="1" Grid.Column="1" Width="320" VerticalAlignment="Top"
              Background="#14000000" CornerRadius="8" Padding="12">
        <StackPanel Spacing="8">
          <TextBlock Text="摄像头预览" FontSize="16" FontWeight="SemiBold" />
          <Grid x:Name="PreviewArea" Height="180" Background="#22000000" CornerRadius="6">
            <TextBlock x:Name="PreviewPlaceholder" Text="预览未开启" Opacity="0.5"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            <!-- Viewbox 等比缩放：内部按摄像头原始像素布局，人脸框坐标无需换算 -->
            <Viewbox>
              <Grid>
                <Image x:Name="PreviewElement" Stretch="None" />
                <Canvas IsHitTestVisible="False">
                  <Rectangle x:Name="FaceBox" Stroke="#35D07F" StrokeThickness="6" RadiusX="8" RadiusY="8" Visibility="Collapsed" />
                </Canvas>
              </Grid>
            </Viewbox>
          </Grid>
          <TextBlock x:Name="CameraStatusText" Text="摄像头状态：尚未打开" Opacity="0.75" TextWrapping="Wrap" />
          <TextBlock x:Name="FaceStatusText" Text="人脸状态：等待检测" Opacity="0.75" TextWrapping="Wrap" />
          <TextBlock Text="预览仅用于本地调整位置，不保存或上传图像。" Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Grid>
  </ScrollViewer>
</Window>
