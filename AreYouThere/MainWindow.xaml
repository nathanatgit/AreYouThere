<Window x:Class="AreYouThere.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:AreYouThere"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">
  <!-- 界面文字都在 MainWindow.xaml.cs 的 Localize() 里按当前语言设置 -->
  <!-- Windows 11 上用 Mica 背景（代码里把这个背景换成透明）；Windows 10 用普通的浅色/深色背景 -->
  <Grid x:Name="WindowRoot" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid.Resources>
      <!--
        文字层级（同一层级同一字号，层级越高字号越大）：
        区域标题 20 粗体 → 卡片标题 16 → 卡片内的分组标题 14 粗体 → 卡片内容 14 → 灰色说明 12（系统次要文字颜色）
        设置卡片的 FontSize="16" 也会传给卡片里的文字，所以卡片里的文字要显式用 CardContent；
        可展开卡片（SettingsExpander）的标题不受 FontSize 影响，代码里用 CardTitle 样式的 TextBlock 作标题（见 CardHeader）
      -->
      <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="1,24,0,8" />
      </Style>
      <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>
      <Style x:Key="GroupLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>
      <Style x:Key="CardContent" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>
      <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
      </Style>
      <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>
    </Grid.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- 沉浸式标题栏：内容延伸到标题栏，最小化/最大化/关闭按钮仍由系统绘制（Windows 10 同样适用） -->
    <Grid x:Name="AppTitleBar" Height="48" Padding="16,0,0,0">
      <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <Image Source="ms-appx:///Assets/logo.png" Width="16" Height="16" />
        <TextBlock x:Name="AppTitleBarText" FontSize="12" VerticalAlignment="Center" />
      </StackPanel>
    </Grid>

    <!-- 大标题固定在标题栏下方，不随内容滚动 -->
    <Border Grid.Row="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
      <StackPanel MaxWidth="1100" Padding="32,4,32,16" Orientation="Horizontal" Spacing="14">
        <Image Source="ms-appx:///Assets/logo.png" Width="48" Height="48" />
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="AppTitleText" FontSize="30" FontWeight="SemiBold" />
          <TextBlock x:Name="AppSubtitleText" Text="AreYouThere" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
      </StackPanel>
    </Border>

  <!-- 启动时把键盘焦点放在滚动区域，避免焦点落在摄像头开关上被误按空格开启 -->
  <!-- 关闭滚动锚定（NaN）：否则展开卡片时下方内容不动、页面往上滚，看起来像向上展开 -->
  <ScrollViewer x:Name="RootScroll" Grid.Row="2" IsTabStop="True" VerticalAnchorRatio="NaN">
    <!-- 宽窗口：设置在左、预览在右；窄窗口：单列，预览插在“检测”之后。切换逻辑见 LayoutRoot_SizeChanged -->
    <Grid x:Name="LayoutRoot" Padding="32,20,32,32" MaxWidth="1100" ColumnSpacing="32" RowSpacing="18"
          SizeChanged="LayoutRoot_SizeChanged">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- 简介和两条可关闭的提示 -->
      <StackPanel Grid.ColumnSpan="2" Spacing="12">
        <TextBlock x:Name="IntroText" Style="{StaticResource CardContent}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <InfoBar x:Name="OfflineBar" IsOpen="True" Severity="Success" IsClosable="True" Closed="NoticeBar_Closed" />
        <InfoBar x:Name="PrivacyBar" IsOpen="True" Severity="Warning" IsClosable="True" Closed="NoticeBar_Closed" />
        <!-- 方案库（同 Windows 设置“蓝牙和其他设备”的卡片）：左边方案卡片可横向滚动，右边新建、导入、导出固定显示。
             卡片在 MainWindow.Profiles.cs 里生成 -->
        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled"
                        VerticalScrollBarVisibility="Disabled" Padding="0,0,0,12">
            <StackPanel x:Name="ProfileGallery" Orientation="Horizontal" Spacing="8" />
          </ScrollViewer>
          <StackPanel x:Name="ProfileActions" Grid.Column="1" Spacing="8" VerticalAlignment="Top" />
        </Grid>
      </StackPanel>

      <!-- 每个设置一行卡片（PowerToys / Windows 设置风格）：左边图标、标题、说明，右边是控件 -->
      <StackPanel x:Name="SettingsPanel" Grid.Row="1" Spacing="4">
        <InfoBar x:Name="CameraProblem" IsOpen="False" Visibility="Collapsed" Severity="Error" IsClosable="False">
          <InfoBar.ActionButton>
            <Button x:Name="CameraPrivacyButton" Click="CameraPrivacyButton_Click" />
          </InfoBar.ActionButton>
        </InfoBar>

        <!-- 状态：最常看的放最上面 -->
        <toolkit:SettingsCard x:Name="EnabledCard" FontSize="16">
          <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE77B;" /></toolkit:SettingsCard.HeaderIcon>
          <toolkit:SettingsCard.Description>
            <StackPanel Spacing="2">
              <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
              <TextBlock x:Name="PowerSummaryText" TextWrapping="Wrap" />
            </StackPanel>
          </toolkit:SettingsCard.Description>
          <!-- 检测开启时可暂停一段时间（菜单项在代码里按 TrayService.PauseChoices 生成）；暂停中换成“恢复” -->
          <StackPanel Orientation="Horizontal" Spacing="12">
            <DropDownButton x:Name="PauseButton" Visibility="Collapsed" VerticalAlignment="Center">
              <DropDownButton.Flyout><MenuFlyout x:Name="PauseMenu" Placement="Bottom" /></DropDownButton.Flyout>
            </DropDownButton>
            <Button x:Name="ResumeButton" Visibility="Collapsed" VerticalAlignment="Center" Click="ResumeButton_Click" />
            <ToggleSwitch x:Name="EnabledSwitch" Toggled="EnabledSwitch_Toggled" />
          </StackPanel>
        </toolkit:SettingsCard>

        <TextBlock x:Name="DetectionHeader" Style="{StaticResource SectionHeader}" />
        <toolkit:SettingsCard x:Name="CameraCard" FontSize="16">
          <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE722;" /></toolkit:SettingsCard.HeaderIcon>
          <toolkit:SettingsCard.Description><TextBlock x:Name="CameraHintText" TextWrapping="Wrap" /></toolkit:SettingsCard.Description>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ComboBox x:Name="CameraBox" MinWidth="180" MaxWidth="240" SelectionChanged="CameraBox_SelectionChanged" />
            <Button x:Name="RefreshCamerasButton" Click="RefreshCameras_Click" />
          </StackPanel>
        </toolkit:SettingsCard>
        <!-- 智能检测：开关在标题行，展开后是检测间隔相关设置。智能检测开启时第一行是“停止操作多久后检测”，关闭时是固定的“检测间隔”；
             递增步长只在智能检测开启时显示，步长不为 0 时再显示最长检测间隔和递增方式 -->
        <toolkit:SettingsExpander x:Name="SmartCard" FontSize="16">
          <toolkit:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE765;" /></toolkit:SettingsExpander.HeaderIcon>
          <toolkit:SettingsExpander.Description><TextBlock x:Name="SmartHintText" TextWrapping="Wrap" /></toolkit:SettingsExpander.Description>
          <ToggleSwitch x:Name="SmartSwitch" Toggled="SmartSwitch_Toggled" />
          <toolkit:SettingsExpander.Items>
            <toolkit:SettingsCard x:Name="IntervalCard" FontSize="16">
              <local:DurationPicker x:Name="IntervalPicker" ShowHours="False" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard x:Name="IntervalStepCard" FontSize="16">
              <toolkit:SettingsCard.Description><TextBlock x:Name="IntervalStepHintText" TextWrapping="Wrap" /></toolkit:SettingsCard.Description>
              <local:DurationPicker x:Name="IntervalStepPicker" ShowHours="False" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard x:Name="MaxIntervalCard" FontSize="16">
              <toolkit:SettingsCard.Description><TextBlock x:Name="MaxIntervalHintText" TextWrapping="Wrap" /></toolkit:SettingsCard.Description>
              <local:DurationPicker x:Name="MaxIntervalPicker" ShowHours="False" />
            </toolkit:SettingsCard>
            <!-- 示例序列放在各自选项下面，只显示选中的那一项 -->
            <toolkit:SettingsCard x:Name="IntervalGrowthCard" FontSize="16" ContentAlignment="Vertical" HorizontalContentAlignment="Left">
              <!-- 不用 RadioButtons：它让每个选项一样高，未选中的选项下面会留出说明文字的空白 -->
              <StackPanel Spacing="4">
                <RadioButton x:Name="GrowthExponentialOption" GroupName="IntervalGrowth" Checked="GrowthOption_Checked">
                  <StackPanel Spacing="2">
                    <TextBlock x:Name="GrowthExponentialText" TextWrapping="Wrap" />
                    <TextBlock x:Name="GrowthExponentialNote" Style="{StaticResource Hint}" />
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="GrowthLinearOption" GroupName="IntervalGrowth" Checked="GrowthOption_Checked">
                  <StackPanel Spacing="2">
                    <TextBlock x:Name="GrowthLinearText" TextWrapping="Wrap" />
                    <TextBlock x:Name="GrowthLinearNote" Style="{StaticResource Hint}" Visibility="Collapsed" />
                  </StackPanel>
                </RadioButton>
              </StackPanel>
            </toolkit:SettingsCard>
          </toolkit:SettingsExpander.Items>
        </toolkit:SettingsExpander>
        <!-- 坐姿检测：展开后设置坐姿检测间隔 -->
        <toolkit:SettingsExpander x:Name="PostureCard" FontSize="16">
          <toolkit:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE7BE;" /></toolkit:SettingsExpander.HeaderIcon>
          <toolkit:SettingsExpander.Description><TextBlock x:Name="PostureHintText" TextWrapping="Wrap" /></toolkit:SettingsExpander.Description>
          <ToggleSwitch x:Name="PostureSwitch" Toggled="PostureSwitch_Toggled" />
          <toolkit:SettingsExpander.Items>
            <!-- 跟随：只在在场检测时顺便看坐姿；自定义：按自己的间隔检测，打字时也照常检测 -->
            <toolkit:SettingsCard x:Name="PostureIntervalPanel" FontSize="16" ContentAlignment="Left">
              <StackPanel Spacing="8">
                <!-- 不用 RadioButtons：它让每个选项一样高，未选中的选项下面会留出说明文字的空白 -->
                <TextBlock x:Name="PostureIntervalHeader" Style="{StaticResource CardContent}" />
                <StackPanel Spacing="4">
                  <RadioButton x:Name="PostureFollowOption" GroupName="PostureInterval" Checked="PostureIntervalMode_Checked">
                    <!-- 智能检测说明紧跟在“跟随”选项下面，因为它只影响这个选项 -->
                    <StackPanel Spacing="2">
                      <TextBlock x:Name="PostureFollowText" TextWrapping="Wrap" />
                      <TextBlock x:Name="PostureFollowNote" Style="{StaticResource Hint}" Visibility="Collapsed" />
                    </StackPanel>
                  </RadioButton>
                  <RadioButton x:Name="PostureCustomOption" GroupName="PostureInterval" Checked="PostureIntervalMode_Checked" />
                </StackPanel>
                <local:DurationPicker x:Name="PostureIntervalPicker" Visibility="Collapsed" />
              </StackPanel>
            </toolkit:SettingsCard>
          </toolkit:SettingsExpander.Items>
        </toolkit:SettingsExpander>

        <TextBlock x:Name="AwayHeader" Style="{StaticResource SectionHeader}" />
        <!-- PowerToys Awake 提示：Awake 保持屏幕常亮时，锁定后屏幕不会息屏 -->
        <InfoBar x:Name="AwakeWarning" IsOpen="False" Visibility="Collapsed" Severity="Informational" IsClosable="False" Margin="0,0,0,4" />
        <!-- 离开电脑后：由『在吗』锁定电脑。说明写在卡片描述里，展开后是锁定时机和倒计时期间的压暗设置。默认展开 -->
        <toolkit:SettingsExpander x:Name="AwayCard" FontSize="16" IsExpanded="True">
          <toolkit:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE72E;" /></toolkit:SettingsExpander.HeaderIcon>
          <toolkit:SettingsExpander.Description><TextBlock x:Name="AwayLockNote" TextWrapping="Wrap" /></toolkit:SettingsExpander.Description>
          <toolkit:SettingsExpander.Items>
            <!-- 只用时长选择器：0 秒为立即锁定，大于 0 为倒计时 -->
            <toolkit:SettingsCard x:Name="LockDelayCard" FontSize="16">
              <toolkit:SettingsCard.Description><TextBlock x:Name="LockDelayHintText" TextWrapping="Wrap" /></toolkit:SettingsCard.Description>
              <local:DurationPicker x:Name="LockDelayPicker" ShowHours="False" />
            </toolkit:SettingsCard>
            <!-- 倒计时期间调暗屏幕：只在锁定模式且延迟大于 0 时有意义 -->
            <toolkit:SettingsCard x:Name="DimCard" FontSize="16" Visibility="Collapsed">
              <ToggleSwitch x:Name="DimSwitch" Toggled="DimSwitch_Toggled" />
            </toolkit:SettingsCard>
            <!-- 调暗方式：黑色遮罩（100% 为全黑，临时保护隐私）或降低显示器亮度；说明只显示在选中的选项下面 -->
            <toolkit:SettingsCard x:Name="DimModeCard" FontSize="16" Visibility="Collapsed" ContentAlignment="Left">
              <StackPanel Spacing="4">
                <RadioButton x:Name="DimOverlayOption" GroupName="DimMode" Checked="DimMode_Checked">
                  <StackPanel Spacing="2">
                    <TextBlock x:Name="DimOverlayText" TextWrapping="Wrap" />
                    <TextBlock x:Name="DimOverlayNote" Style="{StaticResource Hint}" />
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="DimBrightnessOption" GroupName="DimMode" Checked="DimMode_Checked">
                  <StackPanel Spacing="2">
                    <TextBlock x:Name="DimBrightnessText" TextWrapping="Wrap" />
                    <TextBlock x:Name="DimBrightnessNote" Style="{StaticResource Hint}" Visibility="Collapsed" />
                  </StackPanel>
                </RadioButton>
              </StackPanel>
            </toolkit:SettingsCard>
            <!-- 压暗强度：按住滑块拖动时预览，松开即恢复 -->
            <toolkit:SettingsCard x:Name="DimLevelCard" FontSize="16" Visibility="Collapsed">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Slider x:Name="DimLevelSlider" Width="180" Minimum="20" Maximum="100" StepFrequency="5" VerticalAlignment="Center"
                        ValueChanged="DimLevelSlider_ValueChanged" />
                <TextBlock x:Name="DimLevelText" Style="{StaticResource CardContent}" MinWidth="40" VerticalAlignment="Center" />
              </StackPanel>
            </toolkit:SettingsCard>
          </toolkit:SettingsExpander.Items>
        </toolkit:SettingsExpander>
        <!-- 锁定期间的锁屏图片：锁定时换成所选图片，解锁后恢复。未选择时为“不修改” -->
        <toolkit:SettingsCard x:Name="LockImageCard" FontSize="16">
          <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xEB9F;" /></toolkit:SettingsCard.HeaderIcon>
          <toolkit:SettingsCard.Description>
            <StackPanel Spacing="2">
              <TextBlock x:Name="LockImageHintText" TextWrapping="Wrap" />
              <TextBlock x:Name="LockImageOtherAppText" TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>
          </toolkit:SettingsCard.Description>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Border CornerRadius="4" VerticalAlignment="Center">
              <Image x:Name="LockImagePreview" Height="45" MaxWidth="80" Stretch="Uniform" />
            </Border>
            <TextBlock x:Name="LockImageUnchangedText" Style="{StaticResource CardContent}" VerticalAlignment="Center" />
            <Button x:Name="LockImageClearButton" VerticalAlignment="Center" Click="LockImageClear_Click" />
            <Button x:Name="LockImagePickButton" VerticalAlignment="Center" Click="LockImagePick_Click" />
          </StackPanel>
        </toolkit:SettingsCard>

        <!-- 电源策略：与 Windows 设置 › 系统 › 电源 的两组设置相同。每项第一个选项是“不修改（当前：…）”，
             下拉选项在 MainWindow.Power.cs 里按当前系统值生成 -->
        <TextBlock x:Name="PowerHeader" Style="{StaticResource SectionHeader}" />
        <StackPanel Spacing="2" Margin="1,0,0,8">
          <TextBlock x:Name="PowerHintText" Style="{StaticResource Hint}" />
          <HyperlinkButton x:Name="PowerSettingsLink" Padding="0" FontSize="12" NavigateUri="ms-settings:powersleep" />
        </StackPanel>
        <InfoBar x:Name="PowerProblem" IsOpen="False" Visibility="Collapsed" Severity="Warning" IsClosable="True" Margin="0,0,0,4" />
        <toolkit:SettingsExpander x:Name="PowerModeCard" FontSize="16" IsExpanded="True">
          <toolkit:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xEC4A;" /></toolkit:SettingsExpander.HeaderIcon>
          <toolkit:SettingsExpander.Description><TextBlock x:Name="PowerModeHintText" TextWrapping="Wrap" /></toolkit:SettingsExpander.Description>
          <TextBlock x:Name="PowerModeCurrentText" Style="{StaticResource CardContent}" />
          <toolkit:SettingsExpander.Items>
            <toolkit:SettingsCard x:Name="PowerModeAcCard" FontSize="16">
              <ComboBox x:Name="PowerModeAcBox" MinWidth="200" SelectionChanged="PowerBox_SelectionChanged" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard x:Name="PowerModeDcCard" FontSize="16">
              <ComboBox x:Name="PowerModeDcBox" MinWidth="200" SelectionChanged="PowerBox_SelectionChanged" />
            </toolkit:SettingsCard>
          </toolkit:SettingsExpander.Items>
        </toolkit:SettingsExpander>
        <toolkit:SettingsExpander x:Name="TimeoutCard" FontSize="16" IsExpanded="True">
          <toolkit:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE708;" /></toolkit:SettingsExpander.HeaderIcon>
          <toolkit:SettingsExpander.Description>
            <StackPanel Spacing="4">
              <!-- 用电池时锁定期间从不睡眠：电量耗尽会直接关机 -->
              <TextBlock x:Name="NoSleepWarningText" TextWrapping="Wrap" Visibility="Collapsed"
                         Foreground="{ThemeResource SystemFillColorCautionBrush}" />
              <!-- 现代待机的电脑：睡眠一段时间后可能转入休眠 -->
              <TextBlock x:Name="StandbyNoteText" TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>
          </toolkit:SettingsExpander.Description>
          <toolkit:SettingsExpander.Items>
            <TextBlock x:Name="TimeoutAcHeader" Style="{StaticResource GroupLabel}" Margin="16,12,0,4" />
            <toolkit:SettingsCard x:Name="ScreenOffAcCard" FontSize="16">
              <ComboBox x:Name="ScreenOffAcBox" MinWidth="200" SelectionChanged="PowerBox_SelectionChanged" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard x:Name="SleepAcCard" FontSize="16">
              <ComboBox x:Name="SleepAcBox" MinWidth="200" SelectionChanged="PowerBox_SelectionChanged" />
            </toolkit:SettingsCard>
            <TextBlock x:Name="TimeoutDcHeader" Style="{StaticResource GroupLabel}" Margin="16,12,0,4" />
            <toolkit:SettingsCard x:Name="ScreenOffDcCard" FontSize="16">
              <ComboBox x:Name="ScreenOffDcBox" MinWidth="200" SelectionChanged="PowerBox_SelectionChanged" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard x:Name="SleepDcCard" FontSize="16">
              <ComboBox x:Name="SleepDcBox" MinWidth="200" SelectionChanged="PowerBox_SelectionChanged" />
            </toolkit:SettingsCard>
          </toolkit:SettingsExpander.Items>
        </toolkit:SettingsExpander>

        <TextBlock x:Name="OtherHeader" Style="{StaticResource SectionHeader}" />
        <toolkit:SettingsCard x:Name="StartupCard" FontSize="16">
          <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7E8;" /></toolkit:SettingsCard.HeaderIcon>
          <toolkit:SettingsCard.Description>
            <StackPanel Spacing="6">
              <TextBlock x:Name="StartupStatusText" TextWrapping="Wrap" />
              <!-- 只有永久关闭了开机提醒时才显示 -->
              <Button x:Name="RestoreStartupReminderButton" Visibility="Collapsed" Click="RestoreStartupReminder_Click" />
            </StackPanel>
          </toolkit:SettingsCard.Description>
          <ToggleSwitch x:Name="StartupSwitch" IsEnabled="False" Toggled="StartupSwitch_Toggled" />
        </toolkit:SettingsCard>
        <!-- 节电模式：默认暂停检测，交给系统电源设置；也可以选择继续检测 -->
        <toolkit:SettingsCard x:Name="BatterySaverCard" FontSize="16" ContentAlignment="Vertical" HorizontalContentAlignment="Left">
          <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE83F;" /></toolkit:SettingsCard.HeaderIcon>
          <!-- 说明放在各自选项下面，只显示选中的那一项；不用 RadioButtons，它让每个选项一样高，未选中的选项下面会留出空白 -->
          <StackPanel Spacing="4">
            <RadioButton x:Name="BatterySaverPauseOption" GroupName="BatterySaver" Checked="BatterySaverOption_Checked">
              <StackPanel Spacing="2">
                <TextBlock x:Name="BatterySaverPauseText" TextWrapping="Wrap" />
                <TextBlock x:Name="BatterySaverPauseNote" Style="{StaticResource Hint}" />
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="BatterySaverKeepOption" GroupName="BatterySaver" Checked="BatterySaverOption_Checked">
              <StackPanel Spacing="2">
                <TextBlock x:Name="BatterySaverKeepText" TextWrapping="Wrap" />
                <TextBlock x:Name="BatterySaverKeepNote" Style="{StaticResource Hint}" Visibility="Collapsed" />
              </StackPanel>
            </RadioButton>
          </StackPanel>
        </toolkit:SettingsCard>
        <!-- 托盘通知：默认在全屏应用（如游戏）前台时不弹，避免打断 -->
        <toolkit:SettingsCard x:Name="NotificationCard" FontSize="16" ContentAlignment="Vertical" HorizontalContentAlignment="Left">
          <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xEA8F;" /></toolkit:SettingsCard.HeaderIcon>
          <RadioButtons x:Name="NotificationModeButtons" HorizontalAlignment="Left" SelectionChanged="NotificationMode_SelectionChanged">
            <RadioButton x:Name="NotifyQuietOption" />
            <RadioButton x:Name="NotifyNeverOption" />
            <RadioButton x:Name="NotifyAlwaysOption" />
          </RadioButtons>
        </toolkit:SettingsCard>
        <toolkit:SettingsCard x:Name="LanguageCard" FontSize="16">
          <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xF2B7;" /></toolkit:SettingsCard.HeaderIcon>
          <!-- 语言名称用各自的语言写，看不懂当前语言的人也能找到 -->
          <ComboBox x:Name="LanguageBox" MinWidth="200" SelectionChanged="LanguageBox_SelectionChanged">
            <ComboBoxItem Tag="system" />
            <ComboBoxItem Content="简体中文" Tag="zh" />
            <ComboBoxItem Content="English" Tag="en" />
          </ComboBox>
        </toolkit:SettingsCard>
        <toolkit:SettingsCard x:Name="ThemeCard" FontSize="16">
          <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE790;" /></toolkit:SettingsCard.HeaderIcon>
          <ComboBox x:Name="ThemeBox" MinWidth="200" SelectionChanged="ThemeBox_SelectionChanged">
            <ComboBoxItem />
            <ComboBoxItem />
            <ComboBoxItem />
          </ComboBox>
        </toolkit:SettingsCard>
        <toolkit:SettingsCard x:Name="AboutCard" FontSize="16">
          <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE946;" /></toolkit:SettingsCard.HeaderIcon>
          <toolkit:SettingsCard.Description>
            <StackPanel Spacing="2">
              <TextBlock x:Name="AboutText" TextWrapping="Wrap" />
              <!-- 链接只是交给系统浏览器打开，程序本身仍然不联网 -->
              <HyperlinkButton x:Name="RepoLink" Padding="0" NavigateUri="https://github.com/nathanatgit/AreYouThere">
                <TextBlock x:Name="RepoLinkText" TextWrapping="Wrap" />
              </HyperlinkButton>
              <!-- 关掉顶部提示后才显示 -->
              <HyperlinkButton x:Name="ShowNoticesLink" Padding="0" Visibility="Collapsed" Click="ShowNoticesLink_Click" />
            </StackPanel>
          </toolkit:SettingsCard.Description>
        </toolkit:SettingsCard>
      </StackPanel>

      <Border x:Name="PreviewCard" Grid.Row="1" Grid.Column="1" Width="320" VerticalAlignment="Top"
              Style="{StaticResource Card}" Padding="12">
        <StackPanel Spacing="8">
          <Grid>
            <TextBlock x:Name="PreviewTitle" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
            <ToggleSwitch x:Name="PreviewSwitch" IsOn="True" HorizontalAlignment="Right" MinWidth="0"
                          Toggled="PreviewSwitch_Toggled" />
          </Grid>
          <!-- 有些摄像头送来的画面是横的或倒的：转到预览里的人是正的为止，检测也按这个方向进行 -->
          <Button x:Name="RotateButton" Click="RotateButton_Click" HorizontalAlignment="Stretch" />
          <Grid x:Name="PreviewArea" Height="180" Background="#22000000" CornerRadius="6">
            <TextBlock x:Name="PreviewPlaceholder" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            <!-- Viewbox 等比缩放：内部按摄像头原始像素布局，人脸框坐标无需换算 -->
            <Viewbox>
              <Grid>
                <Image x:Name="PreviewElement" Stretch="None" />
                <!-- 绿框：达到面积阈值、算作你在电脑前；灰框：太小被忽略。框上标注占画面的面积百分比 -->
                <Canvas x:Name="FaceCanvas" IsHitTestVisible="False" />
              </Grid>
            </Viewbox>
          </Grid>
          <TextBlock x:Name="CameraStatusText" Style="{StaticResource CardContent}" />
          <!-- 只在预览真正显示画面时出现（见 Presence_FrameReady / ClearPreview） -->
          <TextBlock x:Name="PreviewNoteText" Style="{StaticResource Hint}" Visibility="Collapsed" />
          <TextBlock x:Name="FaceStatusText" Style="{StaticResource CardContent}" />
          <Slider x:Name="FaceAreaSlider" Margin="0,8,0,0" Minimum="0" Maximum="50" StepFrequency="0.5"
                  TickFrequency="5" TickPlacement="Outside" ValueChanged="FaceAreaSlider_ValueChanged" />
          <TextBlock x:Name="FaceAreaText" Style="{StaticResource CardContent}" />
          <!-- 坐姿检测打开时才显示：预览里的橙色虚线就是坐姿线 -->
          <StackPanel x:Name="PosturePanel" Spacing="8" Margin="0,8,0,0" Visibility="Collapsed">
            <Slider x:Name="PostureSlider" Minimum="10" Maximum="80" StepFrequency="1"
                    TickFrequency="10" TickPlacement="Outside" ValueChanged="PostureSlider_ValueChanged" />
            <TextBlock x:Name="PostureLineText" Style="{StaticResource CardContent}" />
            <Slider x:Name="PostureAreaSlider" Margin="0,8,0,0" Minimum="5" Maximum="60" StepFrequency="0.5"
                    TickFrequency="5" TickPlacement="Outside" ValueChanged="PostureAreaSlider_ValueChanged" />
            <TextBlock x:Name="PostureAreaText" Style="{StaticResource CardContent}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </ScrollViewer>
  </Grid>
</Window>
