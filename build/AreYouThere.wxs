<!--
  「在吗」MSI 安装包（WiX 5）。由 build/build-release.ps1 调用：
    wix build AreYouThere.wxs -arch x64 -d Version=0.1.0 -d SourceDir=<publish 目录> -d IconFile=<icon.ico>
  安装到 Program Files\AreYouThere，并在开始菜单创建快捷方式。
  UpgradeCode 不能修改，否则新版本无法自动替换旧版本。
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="在吗 AreYouThere"
           Manufacturer="NathanHan"
           Version="$(Version)"
           UpgradeCode="6C2B7A4E-3F1D-4B8A-9E25-0D7C41A9F3B6"
           Language="2052"
           Codepage="936"
           Scope="perMachine">
    <SummaryInformation Description="在吗 AreYouThere：检测到你在电脑前时阻止 Windows 自动息屏。完全离线运行。" Codepage="936" />

    <!-- 同版本号的安装包也替换已安装的版本，否则会并排装出两个同名条目 -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="已经安装了更新版本的『在吗』。" />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="$(IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/nathanatgit/AreYouThere" />
    <!-- 不创建系统还原点：否则安装/卸载开始时会卡住几十秒才弹出 UAC -->
    <Property Id="MSIFASTINSTALL" Value="1" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="AreYouThere">
        <Files Include="$(SourceDir)\**" />
      </Directory>
    </StandardDirectory>

    <!-- 卸载（非升级）时删除程序在 HKCU\...\Run 注册的开机启动项。只删除指向本安装目录的值，
         不影响便携版；只清理执行卸载的用户；升级时保留，因为安装路径不变。
         安装程序在服务会话中执行：那里 HKCU 不指向用户的注册表，所以以 SYSTEM 身份访问 HKU\[UserSID]；
         也不能运行 AreYouThere.exe 本身，WinUI 程序在那里无法启动。 -->
    <CustomAction Id="RemoveStartupEntry" Directory="SystemFolder"
                  ExeCommand="&quot;[SystemFolder]cmd.exe&quot; /d /c reg query HKU\[UserSID]\Software\Microsoft\Windows\CurrentVersion\Run /v AreYouThere | findstr /i /c:&quot;[INSTALLFOLDER]AreYouThere.exe&quot; &amp;&amp; reg delete HKU\[UserSID]\Software\Microsoft\Windows\CurrentVersion\Run /v AreYouThere /f"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="RemoveStartupEntry" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

    <!-- 安装完成后启动程序。这个安装包没有向导界面，不启动的话用户只看到进度条一闪而过。
         放在界面序列里：由安装程序的客户端进程以当前用户身份启动（不是管理员，也不在服务会话里）；
         静默安装（/qn）不执行界面序列，因此不会启动。只在首次安装和升级时启动，修复、卸载时不启动。 -->
    <CustomAction Id="LaunchApp" Directory="INSTALLFOLDER" ExeCommand="&quot;[INSTALLFOLDER]AreYouThere.exe&quot;"
                  Execute="immediate" Return="asyncNoWait" />
    <InstallUISequence>
      <Custom Action="LaunchApp" After="ExecuteAction" Condition="NOT Installed AND NOT REMOVE" />
    </InstallUISequence>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut">
        <Shortcut Id="AppShortcut" Name="在吗 AreYouThere" Description="检测到你在电脑前时阻止 Windows 自动息屏"
                  Target="[INSTALLFOLDER]AreYouThere.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
        <RegistryValue Root="HKLM" Key="Software\AreYouThere" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>
  </Package>
</Wix>
