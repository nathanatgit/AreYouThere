<Window x:Class="AreYouThere.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
  <!-- 界面文字都在 MainWindow.xaml.cs 的 Localize() 里按当前语言设置 -->
  <!-- 启动时把键盘焦点放在滚动区域，避免焦点落在摄像头开关上被误按空格开启 -->
  <ScrollViewer x:Name="RootScroll" IsTabStop="True">
    <!-- 宽窗口：设置在左、小预览在右；窄窗口：单列，预览在下方。切换逻辑见 LayoutRoot_SizeChanged -->
    <Grid x:Name="LayoutRoot" Padding="32" MaxWidth="1100" ColumnSpacing="32" RowSpacing="18"
          SizeChanged="LayoutRoot_SizeChanged">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Grid.ColumnSpan="2" Spacing="12">
        <StackPanel Orientation="Horizontal" Spacing="14">
          <Image Source="ms-appx:///Assets/logo.png" Width="48" Height="48" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="AppTitleText" FontSize="30" FontWeight="SemiBold" />
            <TextBlock x:Name="AppSubtitleText" Text="AreYouThere" Opacity="0.6" />
          </StackPanel>
        </StackPanel>
        <TextBlock x:Name="IntroText" Opacity="0.75" TextWrapping="Wrap" />
        <InfoBar x:Name="OfflineBar" IsOpen="True" Severity="Success" IsClosable="False" />
      </StackPanel>

      <StackPanel x:Name="SettingsPanel" Grid.Row="1" Spacing="18">
        <InfoBar x:Name="PrivacyBar" IsOpen="True" Severity="Warning" IsClosable="False" />
        <InfoBar x:Name="AwakeWarning" IsOpen="False" Visibility="Collapsed" Severity="Warning" IsClosable="False" />
        <InfoBar x:Name="CameraProblem" IsOpen="False" Visibility="Collapsed" Severity="Error" IsClosable="False">
          <InfoBar.ActionButton>
            <Button x:Name="CameraPrivacyButton" Click="CameraPrivacyButton_Click" />
          </InfoBar.ActionButton>
        </InfoBar>
        <StackPanel Spacing="8">
          <TextBlock x:Name="CameraLabel" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ComboBox x:Name="CameraBox" MinWidth="300" MaxWidth="420"
                      SelectionChanged="CameraBox_SelectionChanged" />
            <Button x:Name="RefreshCamerasButton" Click="RefreshCameras_Click" />
          </StackPanel>
          <TextBlock x:Name="CameraHintText" Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
        <ToggleSwitch x:Name="EnabledSwitch" Toggled="EnabledSwitch_Toggled" />
        <ToggleSwitch x:Name="StartupSwitch" IsEnabled="False" Toggled="StartupSwitch_Toggled" />
        <TextBlock x:Name="StartupStatusText" Opacity="0.65" TextWrapping="Wrap" />
        <Button x:Name="RestoreStartupReminderButton" IsEnabled="False" Click="RestoreStartupReminder_Click" />
        <ToggleSwitch x:Name="PreviewSwitch" IsOn="True" Toggled="PreviewSwitch_Toggled" />
        <StackPanel Spacing="8">
          <TextBlock x:Name="IntervalLabel" />
          <ComboBox x:Name="IntervalBox" SelectedIndex="2" SelectionChanged="IntervalBox_SelectionChanged" Width="220">
            <ComboBoxItem Tag="15" />
            <ComboBoxItem Tag="30" />
            <ComboBoxItem Tag="60" />
            <ComboBoxItem Tag="120" />
            <ComboBoxItem Tag="300" />
          </ComboBox>
        </StackPanel>
        <StackPanel Spacing="8">
          <RadioButtons x:Name="AwayModeButtons" SelectedIndex="0"
                        SelectionChanged="AwayModeButtons_SelectionChanged">
            <RadioButton x:Name="AwayFollowOption" />
            <RadioButton x:Name="AwayLockOption" />
          </RadioButtons>
          <ComboBox x:Name="LockDelayBox" Width="260" SelectedIndex="2" Visibility="Collapsed"
                    SelectionChanged="LockDelayBox_SelectionChanged">
            <ComboBoxItem Tag="0" />
            <ComboBoxItem Tag="15" />
            <ComboBoxItem Tag="30" />
            <ComboBoxItem Tag="60" />
            <ComboBoxItem Tag="120" />
            <ComboBoxItem Tag="-1" />
          </ComboBox>
          <TextBlock x:Name="PolicyText" Opacity="0.75" TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock x:Name="StatusText" Opacity="0.75" TextWrapping="Wrap" />
        <TextBlock x:Name="TrayHintText" TextWrapping="Wrap" Opacity="0.65" />
        <TextBlock x:Name="PowerSummaryText" TextWrapping="Wrap" Opacity="0.75" />
        <!-- 语言名称用各自的语言写，看不懂当前语言的人也能找到 -->
        <ComboBox x:Name="LanguageBox" Width="220" SelectionChanged="LanguageBox_SelectionChanged">
          <ComboBoxItem Tag="system" />
          <ComboBoxItem Content="简体中文" Tag="zh" />
          <ComboBoxItem Content="English" Tag="en" />
        </ComboBox>
        <StackPanel Spacing="4" Margin="0,8,0,0">
          <TextBlock x:Name="AboutHeader" FontWeight="SemiBold" />
          <TextBlock x:Name="AboutText" Opacity="0.75" TextWrapping="Wrap" />
          <!-- 链接只是交给系统浏览器打开，程序本身仍然不联网 -->
          <HyperlinkButton x:Name="RepoLink" Padding="0" NavigateUri="https://github.com/nathanatgit/AreYouThere">
            <TextBlock x:Name="RepoLinkText" TextWrapping="Wrap" />
          </HyperlinkButton>
        </StackPanel>
      </StackPanel>

      <Border x:Name="PreviewCard" Grid.Row="1" Grid.Column="1" Width="320" VerticalAlignment="Top"
              Background="#14000000" CornerRadius="8" Padding="12">
        <StackPanel Spacing="8">
          <TextBlock x:Name="PreviewTitle" FontSize="16" FontWeight="SemiBold" />
          <Grid x:Name="PreviewArea" Height="180" Background="#22000000" CornerRadius="6">
            <TextBlock x:Name="PreviewPlaceholder" Opacity="0.5"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            <!-- Viewbox 等比缩放：内部按摄像头原始像素布局，人脸框坐标无需换算 -->
            <Viewbox>
              <Grid>
                <Image x:Name="PreviewElement" Stretch="None" />
                <!-- 绿框：达到面积阈值、算作你在电脑前；灰框：太小被忽略。框上标注占画面的面积百分比 -->
                <Canvas x:Name="FaceCanvas" IsHitTestVisible="False" />
              </Grid>
            </Viewbox>
          </Grid>
          <TextBlock x:Name="CameraStatusText" Opacity="0.75" TextWrapping="Wrap" />
          <TextBlock x:Name="FaceStatusText" Opacity="0.75" TextWrapping="Wrap" />
          <TextBlock x:Name="PreviewNoteText" Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
          <Slider x:Name="FaceAreaSlider" Minimum="0" Maximum="50" StepFrequency="0.5"
                  TickFrequency="5" TickPlacement="Outside" ValueChanged="FaceAreaSlider_ValueChanged" />
          <TextBlock x:Name="FaceAreaText" Opacity="0.75" TextWrapping="Wrap" />
          <TextBlock x:Name="FaceAreaHintText" Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Grid>
  </ScrollViewer>
</Window>
